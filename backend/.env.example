# Use existing Supabase PostgreSQL credentials, or configure MongoDB instead.
DATABASE_URL=
MONGO_URL=mongodb://localhost:27017
DB_NAME=vidbharat
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_URL=http://localhost:3003
COOKIE_SECURE=false
GEMINI_API_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
# developer uses GEMINI_API_KEY (AI Studio); vertex uses Cloud Run identity or ADC.
IMAGE_PROVIDER=developer
# For the small Cloud Run bridge used by a local beta, choose worker and set both values below.
IMAGE_WORKER_URL=
IMAGE_WORKER_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Keep sample images and placeholder export off for creator-facing runs.
ALLOW_IMAGE_FALLBACK=false
PLACEHOLDER_USE_SAMPLES=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
