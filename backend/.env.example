# Use existing Supabase PostgreSQL credentials, or configure MongoDB instead.
DATABASE_URL=
MONGO_URL=mongodb://localhost:27017
DB_NAME=vidbharat
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_URL=http://localhost:3004
COOKIE_SECURE=false
GEMINI_API_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Text provider priority (comma-separated): developer (GEMINI_API_KEY) and/or vertex
# (GOOGLE_CLOUD_PROJECT + Cloud Run identity or ADC). vertex,developer = billed Vertex first, key as fallback.
TEXT_PROVIDER=developer
# developer uses GEMINI_API_KEY (AI Studio); vertex uses Cloud Run identity or ADC.
IMAGE_PROVIDER=developer
# For the small Cloud Run bridge used by a local beta, choose worker and set both values below.
IMAGE_WORKER_URL=
IMAGE_WORKER_TOKEN=
IMAGE_SCENE_GAP_SECONDS=0
IMAGE_WORKER_RETRY_DELAY=30
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_SPEECH_LOCATION=global
GOOGLE_SPEECH_MODEL=long
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Keep sample images and placeholder export off for creator-facing runs.
ALLOW_IMAGE_FALLBACK=false
PLACEHOLDER_USE_SAMPLES=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# edge (legacy default), piper, supertonic, google_chirp or openai. Premium routes must be
# explicitly configured here before the frontend can offer them.
TTS_PROVIDER=edge
# Premium voice stays unavailable until both an operator cap and a reviewed
# upper-bound INR rate are configured. Chirp's rate must also cover caption STT.
# Verify current vendor prices and exchange rates before enabling a provider.
TTS_PREMIUM_MAX_REQUEST_INR=
TTS_PREMIUM_RATES_JSON={}
# Optional operator-hosted Piper HTTP voices. Each language entry needs url,
# model_id, model_revision, license_url, license_status=verified-commercial,
# and hardware_requirements. Do not enable from the repo-level MIT label alone:
# some individual Piper voices have noncommercial dataset terms.
PIPER_VOICES_JSON={}
# Optional local Hindi Supertonic 3 (M1) route. The model must be downloaded
# separately at the pinned revision with its OpenRAIL-M LICENSE file. The app
# never auto-downloads it. Video exports visibly disclose AI narration.
SUPERTONIC_HINDI_MODEL_DIR=
SUPERTONIC_HINDI_MODEL_REVISION=aafc6e32416a594460b32413efc49d7fe4ce6d46
# In production the same private Supertonic worker serves Hindi and English.
SUPERTONIC_HINDI_SERVICE_URL=
# Production scene and rendering run as independent Cloud Run Jobs.
CLOUD_SCENE_JOB=
CLOUD_RENDER_JOB=
GOOGLE_CLOUD_REGION=asia-south1
GCS_BUCKET=

# Phase 0: reviewed feedback only; production limits use the migration tables.
PERSONALIZED_HOOKS=false
BETA_INVITE_EMAILS=
