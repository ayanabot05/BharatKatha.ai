PORT=3004
REACT_APP_BACKEND_URL=http://localhost:8000

# For a local UI session against the private Cloud Run API, set
# REACT_APP_BACKEND_URL=/ and BHARATKATHA_DEV_API_ORIGIN to its HTTPS origin.
# The development proxy obtains a Google identity token on the server side.
# Never set BHARATKATHA_DEV_API_ORIGIN in a production Vercel build.
